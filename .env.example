# Copy to .env at the repo root. Both contracts/ and ai-service/ read this file.
# Never commit .env.

# --- Chain -------------------------------------------------------------
CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org          # used by Hardhat for deploys
ETHERSCAN_API_KEY=                               # free at etherscan.io; enables tx history

# --- Deploying (contracts only) ------------------------------------------
# A throwaway testnet key with a little Sepolia ETH from a faucet. NEVER a real-money key.
DEPLOYER_PRIVATE_KEY=

# --- AI service -----------------------------------------------------------
ANTHROPIC_API_KEY=                               # leave empty to use the rules-based fallback
ANTHROPIC_MODEL=claude-sonnet-5-5
CORS_ORIGINS=http://localhost:5173
MAX_TRANSACTIONS=25
